{
    "name": "popphp/pop-pdf",
    "description": "PHP PDF library for generating and importing PDF documents. A component of the Pop PHP Framework",
    "keywords": [
        "pdf",
        "create pdf",
        "import pdf",
        "merge pdf",
        "extract pdf text",
        "pdf generation",
        "php pdf library",
        "php pdf processing",
        "html-to-pdf",
        "php",
        "pop",
        "pop php"
    ],
    "homepage": "http://github.com/popphp/pop-pdf",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Nick Sagona, III",
            "email": "nick@popphp.org",
            "homepage": "https://www.popphp.org/"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "popphp/pop-color" : "^2.0.0",
        "popphp/pop-css" : "^3.0.0",
        "popphp/pop-dom" : "^5.0.0",
        "popphp/pop-utils" : "^3.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.0",
        "phpstan/phpstan": "^2.2"
    },
    "suggest": {
        "ext-gd": "For added images to PDFs",
        "ext-imagick": "For advanced image management in PDFs",
        "ext-iconv": "For string conversion",
        "ext-mbstring": "For working with multi-byte string",
        "ext-zlib": "For compression"
    },
    "autoload": {
        "psr-4": {
            "Pop\\Pdf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pop\\Pdf\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "6.0.x-dev"
        }
    }
}

